{
  "name": "modelpickr",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "npm run widget",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run widget",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "pretypecheck": "npm run widget",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run widget",
    "test": "tsx --test tests/*.test.ts",
    "sync": "tsx scripts/sync-catalog.mts",
    "widget": "tsx scripts/build-widget.mts",
    "e2e": "sh scripts/e2e-docker.sh",
    "e2e:update": "sh scripts/e2e-docker.sh --update-snapshots"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
